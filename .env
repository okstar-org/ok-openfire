# Build configuration for ok-openfire docker images.
#
# Each KEY=VALUE pair is passed to `docker buildx build` as a --build-arg,
# overriding the ARG defaults declared in the Dockerfile.
# Lines starting with '#' and blank lines are ignored.
#
# Point OPENFIRE_CONFIG_FILE at a different file to override this one.

# Base image registry prefix (includes the "library" namespace).
# Use "library" to pull straight from Docker Hub instead of the mirror.
MIRROR=swr.cn-north-4.myhuaweicloud.com
OPENFIRE_BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library
